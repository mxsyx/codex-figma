<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">

<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.codex.figma-bridge</string>

  <key>ProgramArguments</key>
  <array>
    <string>path to codex-figma-bridge</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/tmp/codex-figma-bridge.log</string>

  <key>StandardErrorPath</key>
  <string>/tmp/codex-figma-bridge.err.log</string>

  <key>EnvironmentVariables</key>
<dict>
  <key>PATH</key>
  <string>path to node</string>
</dict>
</dict>
</plist>