{
  "name": "@codex-figma/bridge",
  "version": "0.1.0",
  "description": "Local HTTP bridge + MCP server that exposes the user's live Figma selection to Codex CLI.",
  "type": "module",
  "bin": {
    "codex-figma-bridge": "./bin/codex-figma-bridge.mjs"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node bin/codex-figma-bridge.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20"
  }
}
